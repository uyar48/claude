# --- Sunucu (Vercel ortam değişkenleri) ---
# Supabase projesi: Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Uygulamaya giriş yapabilecek tek e-posta
ALLOWED_EMAIL=
# Web push (npm run vapid ile üret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Zamanlayıcı çağrısı için gizli anahtar (rastgele uzun bir metin)
CRON_SECRET=

# --- Medya üretimi (yalnızca npm run media sırasında) ---
# image: google | openai | placeholder
IMAGE_PROVIDER=
IMAGE_API_KEY=
# Karşılaştırma için sağlayıcıya özel anahtarlar (isteğe bağlı)
IMAGE_API_KEY_GOOGLE=
IMAGE_API_KEY_OPENAI=
# tts: elevenlabs | openai | google | browser
TTS_PROVIDER=
TTS_API_KEY=
TTS_API_KEY_ELEVENLABS=
TTS_API_KEY_OPENAI=
