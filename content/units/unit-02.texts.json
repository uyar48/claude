   "title": "My Sister",
   "titleTr": "Kız kardeşim",
   "voice": "female",
   "sentences": [
    {
     "en": "I have a sister and a brother.",
     "tr": "Bir kız kardeşim ve bir erkek kardeşim var."
    },
    {
     "en": "My sister has two children, a son and a daughter.",
     "tr": "Kız kardeşimin iki çocuğu var, bir oğlu ve bir kızı."
