    {
     "en": "After that, I went to bed.",
     "tr": "Ondan sonra yatağa gittim."
    },
    {
     "en": "I slept very well.",
     "tr": "Çok iyi uyudum."
    },
    {
     "en": "Today I feel good.",
     "tr": "Bugün kendimi iyi hissediyorum."
