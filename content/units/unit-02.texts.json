     "en": "Her husband works for a company.",
     "tr": "Kocası bir şirkette çalışıyor."
    },
    {
     "en": "My brother lives in the same street.",
     "tr": "Erkek kardeşim aynı sokakta oturuyor."
    },
    {
     "en": "He has a dog and a cat.",
     "tr": "Bir köpeği ve bir kedisi var."
    },
    {
     "en": "In the evening, we eat at my house.",
     "tr": "Akşamları benim evimde yemek yiyoruz."
    },
    {
     "en": "The children play with the dog.",
     "tr": "Çocuklar köpekle oynuyor."
    },
    {
     "en": "My sister and I drink tea and talk.",
     "tr": "Kız kardeşim ve ben çay içip konuşuyoruz."
    },
    {
     "en": "I am happy when they are here.",
     "tr": "Onlar buradayken mutluyum."
