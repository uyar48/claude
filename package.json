{
  "name": "okuma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "tsx scripts/serve.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "media": "NODE_USE_ENV_PROXY=1 tsx scripts/generate-media.ts",
    "icons": "tsx scripts/make-icons.ts",
    "vapid": "tsx scripts/vapid.ts",
    "deploy": "NODE_USE_ENV_PROXY=1 tsx scripts/deploy.ts",
    "build-content": "tsx scripts/build-content.ts",
    "import-tatoeba": "tsx scripts/import-tatoeba.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "idb": "^8.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
